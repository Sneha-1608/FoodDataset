/test_predictions.csv\n"]}],"source":["import os, glob, zipfile, random\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.image as mpimg\n","import seaborn as sns\n","from sklearn.metrics import confusion_matrix, classification_report, accuracy_score, f1_score\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","DRIVE_ROOT  = \"/content/drive/MyDrive/CEP_Food_Dataset\"\n","RESIZED_DIR = \"/content/resized_256\"   # local image cache (optional, only for Step 2 visuals)\n","\n","# Locate the predictions file anywhere under the project folder\n","# (handles the duplicate 'outputs' folders by taking the newest match).\n","csv_matches = glob.glob(f\"{DRIVE_ROOT}/**/test_predictions.csv\", recursive=True)\n","assert csv_matches, (\n","    \"test_predictions.csv not found under \" + DRIVE_ROOT +\n","    \". Run the S1 training pipeline to the end - its final cell writes this file.\")\n","CSV_PATH = sorted(csv_matches, key=os.path.getmtime)[-1]\n","print(\"Predictions file:\", CSV_PATH)"]},{"cell_type":"code","source":["# OPTIONAL - only needed to view example images in Step 2 (CPU only, no GPU).\n","# Pulls resized_256.zip from Drive and extracts into its own dedicated folder\n","# (avoids the loose-extraction problem where class folders land straight in /content).\n","def _has_class_dirs(d):\n","    return os.path.isdir(d) and any(\n","        os.path.isdir(os.path.join(d, x)) for x in os.listdir(d))\n","\n","if not _has_class_dirs(RESIZED_DIR):\n","    zip_matches = glob.glob(f\"{DRIVE_ROOT}/**/resized_256.zip\", recursive=True)\n","    if zip_matches:\n","        with zipfile.ZipFile(sorted(zip_matches, key=os.path.getmtime)[-1]) as z:\n","            z.extractall(RESIZED_DIR)\n","        n = len([x for x in os.listdir(RESIZED_DIR)\n","                 if os.path.isdir(os.path.join(RESIZED_DIR, x))])\n","        print(\"Image cache ready:\", n, \"classes\")\n","    else:\n","        print(\"resized_256.zip not found - Step 2 image display will be skipped.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"YzsALVGl3lwC","executionInfo":{"status":"ok","timestamp":1784707756726,"user_tz":-330,"elapsed":6042,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"acf88193-75bb-4620-b7b5-3a17b23c9488"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Image cache ready: 100 classes\n"]}]},{"cell_type":"markdown","source":["---\n","## Step 1 (15 min): Load Predictions and Compute Overall Accuracy"],"metadata":{"id":"KRbDM_WA3wlf"}},{"cell_type":"code","source":["preds_df = pd.read_csv(CSV_PATH)\n","\n","# Predictions may be stored as integer class indices OR as dish-name strings.\n","# If numeric, map them to names using the SAME order S1 used: sorted folder names.\n","if pd.api.types.is_numeric_dtype(preds_df['true_class']):\n","    if _has_class_dirs(RESIZED_DIR):\n","        idx_to_name = sorted([d for d in os.listdir(RESIZED_DIR)\n","                              if os.path.isdir(os.path.join(RESIZED_DIR, d))])\n","        preds_df['true_class'] = preds_df['true_class'].astype(int).map(lambda i: idx_to_name[i])\n","        preds_df['pred_class'] = preds_df['pred_class'].astype(int).map(lambda i: idx_to_name[i])\n","        print(\"Mapped integer labels -> dish names.\")\n","    else:\n","        print(\"Labels are numeric and the image cache isn't extracted, so the axes will\")\n","        print(\"show class indices. Run the Step 0 optional cell to get dish names.\")\n","\n","print(preds_df.head())\n","print()\n","overall_acc = accuracy_score(preds_df['true_class'], preds_df['pred_class'])\n","print(f\"Overall test accuracy: {overall_acc*100:.2f}%   (n = {len(preds_df):,} test images)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QjanLIt230n1","executionInfo":{"status":"ok","timestamp":1784707767388,"user_tz":-330,"elapsed":951,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"5e513b88-aac9-4d1a-8bf7-98649478665d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["   true_label_idx  pred_label_idx       true_class       pred_class  \\\n","0              92              92             Upma             Upma   \n","1              40              40  Jamun_shrikhand  Jamun_shrikhand   \n","2               0               0         Aalubhat         Aalubhat   \n","3              20              16  Chicken_tandoor   Chicken_crispy   \n","4              60              70        Misal_pav        Pav_bhaji   \n","\n","   confidence  \n","0    0.994346  \n","1    0.992244  \n","2    0.988402  \n","3    0.750082  \n","4    0.911872  \n","\n","Overall test accuracy: 90.68%   (n = 687 test images)\n"]}]},{"cell_type":"markdown","source":["**Discussion :** Does this single number tell you *which* dishes get confused with each other? What information does one accuracy figure average away?"],"metadata":{"id":"yfb05kHq35XW"}},{"cell_type":"markdown","source":["---\n","## Step 2 (30 min): Build and Visualize the 100x100 Confusion Matrix"],"metadata":{"id":"RC8w4gGY38hv"}},{"cell_type":"code","source":["# Full class axis order (from the cache if available, else from the predictions).\n","if _has_class_dirs(RESIZED_DIR):\n","    class_names = sorted([d for d in os.listdir(RESIZED_DIR)\n","                          if os.path.isdir(os.path.join(RESIZED_DIR, d))])\n","else:\n","    class_names = sorted(set(preds_df['true_class']) | set(preds_df['pred_class']))\n","\n","cm = confusion_matrix(preds_df['true_class'], preds_df['pred_class'], labels=class_names)\n","row_sums = cm.sum(axis=1, keepdims=True)\n","cm_norm = np.divide(cm, row_sums, out=np.zeros_like(cm, dtype=float), where=row_sums != 0)\n","\n","plt.figure(figsize=(16, 14))\n","sns.heatmap(cm_norm, cmap='Blues', square=True, linewidths=0.3,\n","            cbar_kws={'label': 'Row-normalized (recall per true class)'})\n","plt.xlabel('Predicted', fontweight='bold')\n","plt.ylabel('True', fontweight='bold')\n","plt.title(f'{len(class_names)}-Class Confusion Matrix - Test Set', fontweight='bold')\n","ticks = np.arange(0, len(class_names), 10)\n","plt.xticks(ticks, [class_names[i] for i in ticks], rotation=90, fontsize=8)\n","plt.yticks(ticks, [class_names[i] for i in ticks], rotation=0, fontsize=8)\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":479},"id":"vqpo0gz-3-pN","executionInfo":{"status":"ok","timestamp":1784707807994,"user_tz":-330,"elapsed":1596,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"a2da191e-9510-4cfd-a93f-32b68725d0de"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1400 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Top off-diagonal confusions (true -> predicted), ranked by count.\n","off = cm.copy()\n","np.fill_diagonal(off, 0)\n","\n","order = np.argsort(off, axis=None)[::-1]\n","rows = []\n","for flat in order:\n","    i, j = np.unravel_index(flat, off.shape)\n","    c = int(off[i, j])\n","    if c == 0:\n","        break\n","    rows.append((class_names[i], class_names[j], c))\n","    if len(rows) == 10:\n","        break\n","\n","pairs_df = pd.DataFrame(rows, columns=['True', 'Predicted', 'Count'])\n","print(\"Top 10 most-confused dish pairs:\")\n","print(pairs_df.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GTDvbzoZ4BZE","executionInfo":{"status":"ok","timestamp":1784707818713,"user_tz":-330,"elapsed":16,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"5cd486f5-7b29-4d98-cad4-99b9ce7cb8e3"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Top 10 most-confused dish pairs:\n","                    True       Predicted  Count\n","                    Poha        Khichadi      3\n","            Mathura_Peda Motichoor_Laddu      2\n","          Veg_Manchurian     Gajar_Halwa      2\n","            Shevga_bhaji      Palak_soup      2\n","             Egg_biryani Chicken_biryani      2\n","         Chicken_biryani     Egg_biryani      2\n","                Rasgulla        Rasmalai      2\n","Paneer_Broccoli_stir_fry        Khichadi      1\n","                Fish_fry  Kothimbir_Vadi      1\n","           Sabudana_Usal      Fried_rice      1\n"]}]},{"cell_type":"markdown","source":["**Look at the confused dishes.** The helper below pulls random example images for any confused pair straight from the cache. For each top pair, note shared visual features - gravy colour, fried-snack silhouette, plating, garnish - that might explain the confusion."],"metadata":{"id":"b3xz__RO4Fyk"}},{"cell_type":"code","source":["def show_confused_pair(true_cls, pred_cls, n=4):\n","    # Display n random images each from the true and predicted dish folders.\n","    exts = ('.jpg', '.jpeg', '.png')\n","    fig, axes = plt.subplots(2, n, figsize=(3 * n, 6.5))\n","    for row, cls in enumerate([true_cls, pred_cls]):\n","        folder = os.path.join(RESIZED_DIR, cls)\n","        files = [f for f in os.listdir(folder) if f.lower().endswith(exts)] if os.path.isdir(folder) else []\n","        picks = random.sample(files, min(n, len(files)))\n","        for col in range(n):\n","            ax = axes[row, col]; ax.axis('off')\n","            if col < len(picks):\n","                ax.imshow(mpimg.imread(os.path.join(folder, picks[col])))\n","        axes[row, 0].set_title((\"TRUE: \" if row == 0 else \"PRED: \") + cls,\n","                               loc='left', fontweight='bold', fontsize=11)\n","    plt.suptitle(f\"{true_cls}  ->  mistaken as  ->  {pred_cls}\", fontweight='bold', fontsize=13)\n","    plt.tight_layout(); plt.show()\n","\n","if not pairs_df.empty and _has_class_dirs(RESIZED_DIR):\n","    show_confused_pair(pairs_df.iloc[0]['True'], pairs_df.iloc[0]['Predicted'])\n","    # To see the rest, uncomment:\n","    # for _, r in pairs_df.head(5).iterrows(): show_confused_pair(r['True'], r['Predicted'])\n","else:\n","    print(\"Extract the image cache (Step 0 optional cell) to view example images.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":288},"id":"S_iwIG0w4BVs","executionInfo":{"status":"ok","timestamp":1784707847308,"user_tz":-330,"elapsed":1898,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"67c556d6-28ba-4eca-885b-c3218871736d"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x650 with 8 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["---\n","## Step 3 (25 min): Per-Class Precision and Recall"],"metadata":{"id":"jik2Q4y54M59"}},{"cell_type":"code","source":["report_dict = classification_report(\n","    preds_df['true_class'], preds_df['pred_class'],\n","    output_dict=True, zero_division=0)\n","report_df = (pd.DataFrame(report_dict).transpose()\n","             .drop(index=['accuracy', 'macro avg', 'weighted avg'], errors='ignore')\n","             .sort_values('recall'))\n","\n","print(\"5 dishes with LOWEST recall (most often missed):\")\n","print(report_df.head(5)[['precision', 'recall', 'f1-score', 'support']].round(3))\n","print()\n","print(\"5 dishes with HIGHEST recall (most reliably found):\")\n","print(report_df.tail(5)[['precision', 'recall', 'f1-score', 'support']].round(3))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zP2wNRRh4PkI","executionInfo":{"status":"ok","timestamp":1784707876014,"user_tz":-330,"elapsed":67,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"39d051c3-de42-4d8e-ef16-ebc6e1f083ef"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["5 dishes with LOWEST recall (most often missed):\n","                precision  recall  f1-score  support\n","Veg_sandwich        1.000   0.333     0.500      3.0\n","Dahi_Kadhi          1.000   0.500     0.667      2.0\n","Manchow_soup        1.000   0.500     0.667      2.0\n","Chilli_chicken      0.667   0.500     0.571      4.0\n","Misal_pav           0.667   0.500     0.571      4.0\n","\n","5 dishes with HIGHEST recall (most reliably found):\n","                   precision  recall  f1-score  support\n","Pani_Puri              0.333     1.0     0.500      1.0\n","Vadapav                0.800     1.0     0.889      4.0\n","Vada_Sambhar           0.900     1.0     0.947      9.0\n","Veg_Lollipop           1.000     1.0     1.000      8.0\n","Veg_fried_noodles      0.800     1.0     0.889      4.0\n"]}]},{"cell_type":"markdown","source":["**For each of the 5 lowest-recall dishes:** what visual features might explain the low recall? Use culinary knowledge - do they share a base gravy colour, a fried-snack silhouette, or a common garnish with other classes? Cross-check against the confused pairs from Step 2."],"metadata":{"id":"t4O5T2g34SjD"}},{"cell_type":"markdown","source":["---\n","## Step 4 (20 min): Macro, Micro, and Weighted F1-Scores"],"metadata":{"id":"E01To9k64VEJ"}},{"cell_type":"code","source":["macro_f1    = f1_score(preds_df['true_class'], preds_df['pred_class'], average='macro',    zero_division=0)\n","micro_f1    = f1_score(preds_df['true_class'], preds_df['pred_class'], average='micro',    zero_division=0)\n","weighted_f1 = f1_score(preds_df['true_class'], preds_df['pred_class'], average='weighted', zero_division=0)\n","\n","print(f\"Macro F1:    {macro_f1:.4f}   (plain average across all {len(class_names)} classes - every dish counts equally)\")\n","print(f\"Micro F1:    {micro_f1:.4f}   (pools all predictions - equals overall accuracy for single-label multiclass)\")\n","print(f\"Weighted F1: {weighted_f1:.4f}   (average weighted by each dish's support)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pnFJPVOn4Wkn","executionInfo":{"status":"ok","timestamp":1784707909558,"user_tz":-330,"elapsed":56,"user":{"displayName":"320_SNEHA ATTARDE","userId":"08457170313235428612"}},"outputId":"d6ceff7c-39ab-4bbd-bed9-988d4633c041"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Macro F1:    0.8978   (plain average across all 100 classes - every dish counts equally)\n","Micro F1:    0.9068   (pools all predictions - equals overall accuracy for single-label multiclass)\n","Weighted F1: 0.9071   (average weighted by each dish's support)\n"]}]},{"cell_type":"markdown","source":["**Discuss:** why is macro F1 lower than weighted F1 here? (Recall the class-imbalance analysis from Lesson 1 / S2 - rare dishes with poor recall drag the unweighted average down but barely move the weighted one.) Given this dataset's imbalance, which of the three would you report as the headline number, and why?"],"metadata":{"id":"wmui5mLw4aih"}},{"cell_type":"markdown","source":["---\n","## Debrief (30 min)\n","\n","- Which dish pairs were most commonly confused? Does the confusion make culinary sense?\n","- What data-collection or augmentation strategies (see Lesson 4 / S5) might reduce these specific errors?\n","\n","---\n","## Assessment\n","\n","Select the three dishes with the lowest recall in your analysis. For each, write 2-3 sentences explaining (a) the likely visual reason for low recall and (b) one data-collection or modelling change that might improve it.\n","\n","*(Rubric: see Supplementary File S7.)*"],"metadata":{"id":"95SXxorM4ae9"}}]}